### 6.4 接口封装

```csharp
public async Task PushNotificationAsync(PushRequest request)
{
    var jPushRequest = new JPushRequest
    {
        Platform = Platform.All,
        Audience = Audience.Alias(request.UserId),
        Notification = new Notification
        {
            Android = new AndroidNotification
            {
                Title = request.Title,
                Content = request.Content,
                Extras = request.Extras
            },
            iOS = new iOSNotification
            {
                Alert = new { title = request.Title, body = request.Content },
                Extras = request.Extras
            }
        }
    };

    await _pushService.PushAsync(jPushRequest);
}
```

