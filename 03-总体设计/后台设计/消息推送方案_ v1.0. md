## 5. 技术实现

### 5.1 消息服务接口

```csharp
// 创建消息
public async Task<Message> CreateMessage(CreateMessageRequest request)
{
    var message = new Message
    {
        Id = Guid.NewGuid().ToString(),
        UserId = request.UserId,
        Type = request.Type,
        Title = request.Title,
        Content = request.Content,
        Extras = request.Extras,
        IsRead = false,
        CreateTime = DateTime.UtcNow
    };

    // 1. 存入数据库
    await _messageRepo.InsertAsync(message);

    // 2. 发送推送
    if (await _userSettingsService.IsPushEnabled(request.UserId, request.Type))
    {
        await _pushService.SendAsync(request.UserId, request);
    }

    // 3. WebSocket实时推送
    await _webSocketService.SendToUser(request.UserId, message);

    return message;
}

// 标记已读
public async Task MarkAsRead(string userId, string messageId, string type)
{
    await _messageRepo.MarkAsReadAsync(userId, messageId);
    await _userStatsService.UpdateUnreadCountAsync(userId, type, -1);
}
```

### 5.2 WebSocket推送

**连接**：
```wss://api.pindou.com/ws?token={access_token}```

**消息格式**：
```json
{
  "type": "message",
  "data": {
    "id": "msg_xxx",
    "message_type": "comment",
    "title": "收到新评论",
    "content": "用户「小明」评论了你",
    "extras": {...},
    "create_time": "2026-06-07T10:00:00Z"
  }
}
```

### 5.3 推送服务封装

```csharp
public async Task SendPushNotificationAsync(string userId, NotificationRequest request)
{
    // 1. 获取用户设备信息
    var devices = await _deviceService.GetUserDevicesAsync(userId);

    // 2. 过滤已禁用通知的类型
    if (!await _settingsService.IsNotificationEnabled(userId, request.Type))
    {
        return;
    }

    // 3. 检查勿扰时间
    if (await _settingsService.IsInQuietHours(userId))
    {
        // 只存库，不推送
        return;
    }

    // 4. 发送推送
    foreach (var device in devices)
    {
        await _pushProvider.SendAsync(new PushRequest
        {
            DeviceToken = device.Token,
            Platform = device.Platform,
            Title = request.Title,
            Content = request.Content,
            Extras = request.Extras
        });
    }
}
```

