### 3.2 数据库表结构

```sql
-- 帖子表(业务库引用)
-- 实际表在 pindou_community 库中

-- 评论表(业务库引用)
-- 实际表在 pindou_community 库中

-- 敏感词表
CREATE TABLE sensitive_word (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',
    word VARCHAR(100) NOT NULL COMMENT '敏感词',
    level TINYINT NOT NULL DEFAULT 2 COMMENT '级别 1-严重 2-中等 3-轻微',
    type VARCHAR(20) NOT NULL COMMENT '类型 politics/porn/violence/ad/copyright/other',
    replace_word VARCHAR(50) COMMENT '替换词',
    status TINYINT NOT NULL DEFAULT 1 COMMENT '状态 0-禁用 1-启用',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    update_time DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    INDEX idx_word (word),
    INDEX idx_level (level),
    INDEX idx_type (type),
    INDEX idx_status (status)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='敏感词表';

-- 举报表
CREATE TABLE report (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',
    report_id VARCHAR(20) NOT NULL UNIQUE COMMENT '举报唯一ID',
    reporter_id BIGINT NOT NULL COMMENT '举报人ID',
    target_type VARCHAR(20) NOT NULL COMMENT '目标类型 post/comment/user',
    target_id BIGINT NOT NULL COMMENT '目标ID',
    target_user_id BIGINT NOT NULL COMMENT '被举报用户ID',
    reason VARCHAR(20) NOT NULL COMMENT '举报原因',
    content VARCHAR(500) COMMENT '详细说明',
    images JSON COMMENT '截图凭证',
    status VARCHAR(20) NOT NULL DEFAULT 'pending' COMMENT '状态 pending/ignored/warned/ban_content/ban_user',
    handle_result VARCHAR(500) COMMENT '处理结果',
    handler_id BIGINT COMMENT '处理人ID',
    handle_time DATETIME COMMENT '处理时间',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    update_time DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    INDEX idx_reporter_id (reporter_id),
    INDEX idx_target (target_type, target_id),
    INDEX idx_status (status),
    INDEX idx_create_time (create_time)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='举报表';

-- 帖子审核记录表
CREATE TABLE post_review_log (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',
    post_id BIGINT NOT NULL COMMENT '帖子ID',
    reviewer_id BIGINT NOT NULL COMMENT '审核人ID',
    action VARCHAR(20) NOT NULL COMMENT '操作 approve/reject',
    reason VARCHAR(500) COMMENT '原因',
    remark VARCHAR(500) COMMENT '备注',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    INDEX idx_post_id (post_id),
    INDEX idx_reviewer_id (reviewer_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='帖子审核记录表';
```

