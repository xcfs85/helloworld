### 3.2 数据库表结构

```sql
-- 用户表
CREATE TABLE `user` (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',
    user_id VARCHAR(20) NOT NULL UNIQUE COMMENT '用户唯一ID',
    nickname VARCHAR(50) NOT NULL COMMENT '昵称',
    avatar VARCHAR(500) COMMENT '头像URL',
    phone VARCHAR(20) COMMENT '手机号',
    unionid VARCHAR(100) COMMENT '微信unionid',
    openid VARCHAR(100) COMMENT '微信openid',
    apple_user_id VARCHAR(100) COMMENT 'Apple用户ID',
    gender TINYINT DEFAULT 0 COMMENT '性别 0-未知 1-男 2-女',
    city VARCHAR(50) COMMENT '城市',
    register_method VARCHAR(20) NOT NULL COMMENT '注册方式 phone/wechat/apple/guest',
    register_time DATETIME NOT NULL COMMENT '注册时间',
    last_login_time DATETIME COMMENT '最后登录时间',
    last_login_ip VARCHAR(50) COMMENT '最后登录IP',
    is_member TINYINT DEFAULT 0 COMMENT '会员状态 0-非会员 1-会员',
    member_grade VARCHAR(20) COMMENT '会员等级',
    member_expire_time DATETIME COMMENT '会员到期时间',
    status TINYINT DEFAULT 1 COMMENT '状态 0-禁用 1-正常',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    update_time DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    INDEX idx_user_id (user_id),
    INDEX idx_phone (phone),
    INDEX idx_register_time (register_time),
    INDEX idx_status (status)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='用户表';

-- 会员订单表
CREATE TABLE member_order (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',
    order_id VARCHAR(50) NOT NULL UNIQUE COMMENT '订单号',
    user_id BIGINT NOT NULL COMMENT '用户ID',
    product_id VARCHAR(50) NOT NULL COMMENT '产品ID',
    product_name VARCHAR(100) NOT NULL COMMENT '产品名称',
    amount DECIMAL(10,2) NOT NULL COMMENT '支付金额',
    pay_method VARCHAR(20) COMMENT '支付方式 wechat/alipay/ios',
    pay_time DATETIME COMMENT '支付时间',
    start_time DATETIME NOT NULL COMMENT '会员开始时间',
    end_time DATETIME NOT NULL COMMENT '会员结束时间',
    status TINYINT DEFAULT 0 COMMENT '状态 0-待支付 1-已支付 2-已取消',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    INDEX idx_order_id (order_id),
    INDEX idx_user_id (user_id),
    INDEX idx_status (status)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='会员订单表';

-- 会员产品表
CREATE TABLE member_product (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '主键ID',
    product_id VARCHAR(50) NOT NULL UNIQUE COMMENT '产品ID',
    product_name VARCHAR(100) NOT NULL COMMENT '产品名称',
    grade VARCHAR(20) NOT NULL COMMENT '会员等级',
    duration_days INT NOT NULL COMMENT '时长(天)',
    price DECIMAL(10,2) NOT NULL COMMENT '价格',
    original_price DECIMAL(10,2) COMMENT '原价',
    daily_generations INT DEFAULT -1 COMMENT '每日生成次数 -1无限',
    features TEXT COMMENT '权益说明JSON',
    status TINYINT DEFAULT 1 COMMENT '状态 0-下架 1-上架',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    INDEX idx_grade (grade),
    INDEX idx_status (status)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='会员产品表';
```

