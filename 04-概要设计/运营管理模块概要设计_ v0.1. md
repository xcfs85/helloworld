### 2.2 数据库表结构

```sql
-- Banner表
CREATE TABLE banner (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    title VARCHAR(100) NOT NULL COMMENT '标题',
    image_url VARCHAR(500) NOT NULL COMMENT '图片URL',
    link_type VARCHAR(20) NOT NULL COMMENT '链接类型 template/topic/web/activity',
    link_url VARCHAR(500) COMMENT '跳转链接',
    link_param VARCHAR(200) COMMENT '跳转参数',
    position VARCHAR(20) NOT NULL COMMENT '位置编码 home_top/template_top',
    sort INT DEFAULT 0 COMMENT '排序',
    start_time DATETIME NOT NULL COMMENT '上线时间',
    end_time DATETIME NOT NULL COMMENT '下线时间',
    status TINYINT NOT NULL DEFAULT 1 COMMENT '状态 0-禁用 1-启用',
    create_by BIGINT COMMENT '创建人',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    update_time DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_position (position),
    INDEX idx_status (status),
    INDEX idx_start_time (start_time)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='Banner表';

-- 话题表
CREATE TABLE topic (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    topic_id VARCHAR(20) NOT NULL UNIQUE,
    name VARCHAR(100) NOT NULL COMMENT '话题名称',
    description VARCHAR(500) COMMENT '描述',
    cover_url VARCHAR(500) COMMENT '封面图',
    is_official TINYINT DEFAULT 0 COMMENT '是否官方',
    status VARCHAR(20) NOT NULL DEFAULT 'active' COMMENT '状态 active/closed',
    post_count INT DEFAULT 0 COMMENT '帖子数',
    participant_count INT DEFAULT 0 COMMENT '参与人数',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    update_time DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_status (status),
    INDEX idx_is_official (is_official)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='话题表';

-- 专题表
CREATE TABLE special_topic (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL COMMENT '专题名称',
    description VARCHAR(500) COMMENT '描述',
    cover_url VARCHAR(500) NOT NULL COMMENT '封面图',
    template_ids VARCHAR(500) COMMENT '关联模板ID,逗号分隔',
    start_time DATETIME NOT NULL COMMENT '上线时间',
    end_time DATETIME NOT NULL COMMENT '下线时间',
    status TINYINT NOT NULL DEFAULT 1 COMMENT '状态 0-下架 1-上架',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    update_time DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_status (status),
    INDEX idx_start_time (start_time)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='专题表';

-- 推送记录表
CREATE TABLE push_record (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    push_id VARCHAR(20) NOT NULL UNIQUE,
    title VARCHAR(100) NOT NULL,
    content TEXT NOT NULL,
    push_type VARCHAR(20) NOT NULL COMMENT '系统消息/活动通知',
    target_type VARCHAR(20) NOT NULL COMMENT 'all/tag/user',
    target_param VARCHAR(200) COMMENT '目标参数',
    schedule_time DATETIME COMMENT '定时发送时间',
    send_time DATETIME COMMENT '实际发送时间',
    total_count INT DEFAULT 0 COMMENT '推送总数',
    success_count INT DEFAULT 0 COMMENT '成功数',
    click_count INT DEFAULT 0 COMMENT '点击数',
    status VARCHAR(20) NOT NULL DEFAULT 'pending' COMMENT 'pending/sending/sent/failed',
    create_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    update_time DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_status (status),
    INDEX idx_schedule_time (schedule_time)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='推送记录表';
```

