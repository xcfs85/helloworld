### 5.3 敏感词过滤流程

```
1. 初始化敏感词库
   └─> 从数据库加载敏感词到内存
   └─> 构建DFA算法树

2. 文本过滤
   ├─> 遍历DFA树检测敏感词
   ├─> 根据敏感词级别进行处理
   └─> 替换/拦截/警告

3. 敏感词更新
   └─> 修改敏感词后刷新缓存
   └─> 异步重建DFA树
```

### 5.4 DFA敏感词匹配算法

```csharp
public class DFAFilter
{
    private Dictionary<char, object> _filterTree = new();

    /// <summary>构建敏感词树</summary>
    public void BuildTree(List<string> sensitiveWords)
    {
        _filterTree.Clear();
        foreach (var word in sensitiveWords)
        {
            var current = _filterTree;
            foreach (char c in word)
            {
                if (!current.ContainsKey(c))
                    current[c] = new Dictionary<char, object>();
                current = (Dictionary<char, object>)current[c];
            }
            current['\0'] = new object(); // 结束标记
        }
    }

    /// <summary>过滤文本</summary>
    public string Filter(string text, string replaceChar = "**")
    {
        var result = text.ToCharArray();
        for (int i = 0; i < result.Length; i++)
        {
            var current = _filterTree;
            int matchLength = 0;

            for (int j = i; j < result.Length && current.ContainsKey(result[j]); j++)
            {
                current = (Dictionary<char, object>)current[result[j]];
                if (current.ContainsKey('\0'))
                {
                    matchLength = j - i + 1;
                }
            }

            if (matchLength > 0)
            {
                for (int k = i; k < i + matchLength; k++)
                {
                    result[k] = replaceChar[0];
                }
            }
        }

        return new string(result);
    }

    /// <summary>检测是否包含敏感词</summary>
    public bool ContainsSensitive(string text, out List<string> foundWords)
    {
        foundWords = new List<string>();
        // 实现检测逻辑
        return foundWords.Count > 0;
    }
}
```

