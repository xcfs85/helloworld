### 3.2 数据聚合流程

```csharp
public class StatsAggregationJob
{
    /// <summary>每日凌晨2点执行统计聚合</summary>
    [Cron("0 2 * * *")]
    public async Task AggregateDailyStatsAsync()
    {
        var yesterday = DateTime. yesterday. Date;

        // 1. 统计用户数据
        var userStats = await _statsRepository.GetUserStatsAsync(yesterday);

        // 2. 统计创作数据
        var creationStats = await _statsRepository.GetCreationStatsAsync(yesterday);

        // 3. 统计社区数据
        var communityStats = await _statsRepository.GetCommunityStatsAsync(yesterday);

        // 4. 统计会员数据
        var memberStats = await _statsRepository.GetMemberStatsAsync(yesterday);

        // 5. 聚合并保存
        var dailyStats = new DailyStats
        {
            StatDate = yesterday,
            Dau = userStats.Dau,
            NewUserCount = userStats.NewUserCount,
            Retention1d = userStats.Retention1d,
            Retention7d = userStats.Retention7d,
            Retention30d = userStats.Retention30d,
            GenerationCount = creationStats.GenerationCount,
            AvgBeadCount = creationStats.AvgBeadCount,
            AvgColorCount = creationStats.AvgColorCount,
            ExportCount = creationStats.ExportCount,
            PostCount = communityStats.PostCount,
            WorkCount = communityStats.WorkCount,
            TutorialCount = communityStats.TutorialCount,
            CommentCount = communityStats.CommentCount,
            LikeCount = communityStats.LikeCount,
            ShareCount = communityStats.ShareCount,
            FavoriteCount = communityStats.FavoriteCount,
            MemberOrderCount = memberStats.OrderCount,
            MemberRevenue = memberStats.Revenue,
            CreateTime = DateTime.Now
        };

        await _repository.InsertOrUpdateAsync(dailyStats);
    }

    /// <summary>计算留存率</summary>
    public async Task CalculateRetentionAsync(DateTime date, int days)
    {
        var targetDate = date.AddDays(-days);
        var startDate = targetDate. Date;
        var endDate = startDate. AddDays(1);

        // 获取目标日期新增用户
        var newUsers = await _userRepository.GetNewUsersAsync(startDate, endDate);
        var newUserIds = newUsers.Select(u => u.Id).ToList();

        if (newUserIds.Count == 0) return;

        // 计算第days天活跃的用户数
        var activeUserCount = await _userRepository.GetActiveUserCountAsync(date.Date, date.Date.AddDays(1), newUserIds);

        var retentionRate = (decimal)activeUserCount / newUserIds.Count * 100;

        // 更新统计数据
        await _statsRepository.UpdateRetentionAsync(date, days, retentionRate);
    }
}
```

