## 5. 核心流程设计

### 5.1 数据查询流程

```csharp
public async Task<StatsOverviewResponse> GetOverviewAsync(DateType dateType)
{
    // 1. 确定日期范围
    var (startDate, endDate) = GetDateRange(dateType);

    // 2. 缓存检查
    var cacheKey = $"stats:overview:{dateType}:{startDate:yyyyMMdd}";
    var cached = await _redis. GetAsync<StatsOverviewResponse>(cacheKey);
    if (cached != null) return cached;

    // 3. 查询统计表
    var stats = await _statsRepository.GetStatsAsync(startDate, endDate);

    // 4. 计算同比/环比
    var prevStartDate = startDate.AddDays(-GetDays(dateType));
    var prevStats = await _statsRepository.GetStatsAsync(prevStartDate, startDate);

    // 5. 聚合响应
    var response = new StatsOverviewResponse
    {
        Dau = stats.Sum(s => s.Dau),
        DauChange = CalculateChange(stats. Sum(s => s.Dau), prevStats.Sum(s => s.Dau)),
        // ... 其他字段
        Date = endDate.ToString("yyyy-MM-dd")
    };

    // 6. 缓存5分钟
    await _redis.SetAsync(cacheKey, response, TimeSpan.FromMinutes(5));

    return response;
}
```

### 5.2 同比/环比计算

```csharp
public static decimal CalculateChange(decimal current, decimal previous)
{
    if (previous == 0) return current > 0 ? 100 : 0;
    return Math.Round((current - previous) / previous * 100, 1);
}
```

