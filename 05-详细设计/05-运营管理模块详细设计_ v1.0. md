## 5. 核心流程设计

### 5.1 Banner展示逻辑

```csharp
public class BannerService : IBannerService
{
    public async Task<List<Banner>> GetActiveBannersAsync(string position)
    {
        // 1. 检查缓存
        var cacheKey = $"banner:{position}";
        var cached = await _redis.GetAsync<List<Banner>>(cacheKey);
        if (cached != null) return cached;

        // 2. 查询数据库(有效期内、上线状态)
        var banners = await _repository.GetListAsync(b =>
            b.Position == position &&
            b.Status == 1 &&
            b.StartTime <= DateTime.Now &&
            b.EndTime >= DateTime.Now,
            b => b.Sort);

        // 3. 缓存结果(5分钟)
        await _redis.SetAsync(cacheKey, banners, TimeSpan.FromMinutes(5));

        return banners;
    }
}
```

### 5.2 推送发送流程

```csharp
public class PushJob
{
    public async Task ExecuteScheduledPushAsync(long pushRecordId)
    {
        var record = await _repository.GetByIdAsync(pushRecordId);

        // 1. 构建推送请求
        var pushRequest = new JiguangPushRequest
        {
            Title = record.Title,
            Content = record.Content,
            Platform = JiguangPlatform.All,
            Audience = BuildAudience(record.TargetType, record.TargetParam)
        };

        // 2. 调用推送服务
        var result = await _pushClient.SendAsync(pushRequest);

        // 3. 更新推送状态
        record.SendTime = DateTime.Now;
        record.TotalCount = result.TotalCount;
        record.SuccessCount = result.SuccessCount;
        record.Status = result.Success ? "sent" : "failed";
        await _repository.UpdateAsync(record);
    }

    private JiguangAudience BuildAudience(string targetType, string targetParam)
    {
        return targetType switch
        {
            "all" => JiguangAudience.All,
            "tag" => JiguangAudience.Tag(targetParam),
            "user" => JiguangAudience.Alias(targetParam.Split(',')),
            _ => JiguangAudience.All
        };
    }
}
```

### 5.3 定时任务配置

```csharp
// 在Program.cs中配置Hangfire
services.AddHangfire(config => config
    .SetDataCompatibilityLevel(CompatibilityLevel.Version_180)
    .UseSimpleAssemblyNameTypeSerializer()
    .UseRecommendedSerializerSettings()
    .UseSqlServerStorage(connectionString));

