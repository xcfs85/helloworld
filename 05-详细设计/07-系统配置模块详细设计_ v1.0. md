## 5. 核心流程设计

### 5.1 配置读取流程

```csharp
public async Task<string> GetConfigAsync(string key)
{
    // 1. 检查缓存
    var cacheKey = $"config:{key}";
    var cached = await _redis.GetAsync<string>(cacheKey);
    if (cached != null) return cached;

    // 2. 查询数据库
    var config = await _repository.GetByKeyAsync(key);
    if (config == null) return null;

    // 3. 缓存结果(10分钟)
    await _redis.SetAsync(cacheKey, config.ConfigValue, TimeSpan.FromMinutes(10));

    return config.ConfigValue;
}
```

### 5.2 配置更新流程

```csharp
public async Task<Result> SetConfigAsync(string key, string value, string description)
{
    // 1. 更新数据库
    var config = await _repository.GetByKeyAsync(key);
    if (config == null)
    {
        // 新增配置
        config = new SystemConfig { ConfigKey = key, ConfigValue = value, Description = description };
        await _repository.InsertAsync(config);
    }
    else
    {
        // 更新配置
        config.ConfigValue = value;
        if (description != null) config.Description = description;
        await _repository.UpdateAsync(config);
    }

    // 2. 清除缓存
    await _redis.DeleteAsync($"config:{key}");

    // 3. 记录操作日志
    await _logService.LogAsync("config:set", $"设置配置 {key} = {value}");

    return Result.Success();
}
```

### 5.3 色号匹配推荐

```csharp
public class ColorRecommender
{
    /// <summary>根据模板色号推荐套装</summary>
    public List<BeadKit> RecommendKits(List<string> requiredColors)
    {
        var allKits = _kitRepository.GetAll();

        return allKits
            .Select(kit => new
            {
                Kit = kit,
                MatchScore = CalculateMatchScore(kit, requiredColors)
            })
            .Where(x => x.MatchScore > 0.7)
            .OrderByDescending(x => x.MatchScore)
            .Select(x => x.Kit)
            .ToList();
    }

    private double CalculateMatchScore(BeadKit kit, List<string> requiredColors)
    {
        // 检查套装颜色是否覆盖所需颜色
        var kitColors = _colorRepository.GetByKit(kit.KitId);
        var matchedColors = requiredColors.Intersect(kitColors).Count();

        return (double)matchedColors / requiredColors.Count;
    }
}
```

